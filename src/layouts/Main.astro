---
import BaseHead from "../components/BaseHead.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, description, image } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>

  <body
    class:list={[
      "font-mono",
      "max-w-screen-md mx-auto pt-6",
      "bg-slate-50 text-neutral-700",
      "divide-neutral-200 dark:divide-white",
      "dark:bg-[#241f31] dark:text-white",
    ]}
  >
    <Header />
    <main class="w-fit py-4 px-4 antialised flex flex-col mx-auto">
      <article
        class:list={[
          "prose prose-a:no-underline",
          "prose-cyan dark:prose-invert",
        ]}
      >
        <slot />
      </article>
      <Footer />
    </main>
  </body>
</html>
