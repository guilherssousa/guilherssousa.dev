
---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'>;

const { class: className, ...props } = Astro.props;
---

<div
	{...props} 
	class:list={[
		className, 
		"no-prose bg-[#1a1c1e] px-4 py-2 border rounded-md border-[#3d3846] text-white"
	]}
>
	<slot />
</div>
